[Unit]
Description=Hermes-Enhanced App Bridge
After=network.target
PartOf=hermes-enhanced-gateway.service

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/hermes-fork
Environment=HERMES_HOME=/home/ubuntu/.hermes-enhanced
Environment=ENHANCED_BRIDGE_PORT=8644
Environment=HOME=/home/ubuntu
ExecStart=/home/ubuntu/hermes-fork/.venv/bin/python -m hermes_enhanced.server
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
